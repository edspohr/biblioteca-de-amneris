    "export:firestore": "tsx scripts/export-firestore.ts",
    "backfill:etapa-edad": "tsx scripts/backfill-etapa-edad.ts",
    "seed:featured": "tsx scripts/seed-featured-recipes.ts",
    "backup": "tsx scripts/backup.ts",
    "seed:colecciones": "tsx scripts/seed-colecciones.ts",
    "seed:metodos": "tsx scripts/seed-metodos-conservacion.ts",
    "seed:utensilios": "tsx scripts/seed-utensilios.ts",
