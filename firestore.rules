rules_version = '2';

// All writes are denied from clients. Mutations pass exclusively through the
// Next.js server API, which uses the Firebase Admin SDK — the admin SDK
// bypasses these rules and enforces its own `requireSuperadmin()` gate.
//
// Reads are public on the catalog and content collections (the app is a free
// public library). The `usuarios` collection is per-user private and lands in
// Phase 3; the stub below reserves the shape.

service cloud.firestore {
  match /databases/{database}/documents {

    match /etapas/{id}              { allow read: if true;  allow write: if false; }
    match /porciones_texturas/{id}  { allow read: if true;  allow write: if false; }
    match /ingredientes/{id}        { allow read: if true;  allow write: if false; }
    match /alergenos/{id}           { allow read: if true;  allow write: if false; }
    match /tecnicas/{id}            { allow read: if true;  allow write: if false; }
    match /menus/{id}               { allow read: if true;  allow write: if false; }
    match /recetas/{id}             { allow read: if true;  allow write: if false; }

    // Perfil de usuario. Solo el dueño (o superadmins) puede LEER su doc;
    // todas las escrituras pasan por API server-side (Admin SDK), nunca
    // desde el cliente. Esto mantiene la política de "no client writes"
    // consistente en toda la app.
    match /usuarios/{uid} {
      allow read: if request.auth != null
                  && (request.auth.uid == uid
                      || request.auth.token.superadmin == true);
      allow write: if false;
    }

    // Contadores de registro/atribución. Solo se escriben desde el server.
    match /metrics/{doc} {
      allow read, write: if false;
    }

    // Assistant conversation logs — server-only. The chat widget never
    // touches Firestore from the client; all writes come from
    // POST /api/asistente via the admin SDK (which bypasses these rules).
    // The admin "preguntas frecuentes" view also reads via server code.
    match /conversaciones/{sessionId} {
      allow read, write: if false;
      match /mensajes/{msgId} {
        allow read, write: if false;
      }
    }

    // Rate-limit counters — same story. Written by the server on every
    // /api/asistente call, never touched by the client.
    match /asistente_ratelimit/{sessionId} {
      allow read, write: if false;
    }

    // Default deny for anything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
