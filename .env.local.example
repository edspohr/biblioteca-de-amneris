# Firebase Web SDK — client-safe values, exposed to the browser.
# Get these from: Firebase Console → Project settings → Your apps → Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=biblioteca-amneris.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=biblioteca-amneris
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=biblioteca-amneris.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK — server-only. Path to a service account JSON key.
# Get from: Firebase Console → Project settings → Service accounts → Generate new private key.
# In App Hosting, prefer FIREBASE_ADMIN_SA (inline JSON, stored as a secret).
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# FIREBASE_ADMIN_SA={"type":"service_account",...}

# App Check — reCAPTCHA v3 site key. Get from https://www.google.com/recaptcha/admin
# (create a v3 key with domain biblioteca-amneris.web.app + localhost).
# Then register it in Firebase Console → App Check → your web app → reCAPTCHA v3.
NEXT_PUBLIC_RECAPTCHA_V3_SITE_KEY=

# For local development: paste the App Check debug token that appears in the
# browser console the first time you load the app with App Check enabled.
# Register it in Firebase Console → App Check → Apps → Manage debug tokens.
# NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=

# App Check enforcement on the assistant API. Set to true only when Firebase
# Console → App Check → APIs shows all products in "enforced" mode.
# APP_CHECK_ENFORCE=false

# Session cookie name is hardcoded to `__session` in src/lib/auth/cookie.ts.
# Firebase Hosting strips every other cookie name at the rewrite boundary,
# so this cannot be overridden per environment.
