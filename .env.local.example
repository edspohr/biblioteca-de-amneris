# Firebase Web SDK — client-safe values, exposed to the browser.
# Get these from: Firebase Console → Project settings → Your apps → Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=biblioteca-amneris.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=biblioteca-amneris
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=biblioteca-amneris.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK — server-only. Path to a service account JSON key.
# Get from: Firebase Console → Project settings → Service accounts → Generate new private key.
# In App Hosting, prefer FIREBASE_ADMIN_SA (inline JSON, stored as a secret).
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# FIREBASE_ADMIN_SA={"type":"service_account",...}

# Session cookie name — override only if you need multiple envs on one domain.
# SESSION_COOKIE_NAME=__biblioteca_session
